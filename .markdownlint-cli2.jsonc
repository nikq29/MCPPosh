// Markdown lint for the hand-written documentation (rules in .markdownlint.json).
// The cmdlet reference in docs/en-US is generated by PlatyPS and therefore excluded.
{
    "globs": [
        "README.md",
        "CHANGELOG.md",
        "docs/*.md",
        "deploy/azure/README.md"
    ],
    "ignores": [
        "docs/en-US/**",
        "output/**",
        "node_modules/**"
    ]
}
