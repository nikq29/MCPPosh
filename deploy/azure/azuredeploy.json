      },
      "dependsOn": [
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices', variables('storageAccountName'), 'default')]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}-env', parameters('name'))]",
      "location": "[parameters('location')]",
      "properties": {
        "appLogsConfiguration": {
          "destination": "log-analytics",
          "logAnalyticsConfiguration": {
            "customerId": "[reference(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name'))), '2022-10-01').customerId]",
            "sharedKey": "[listKeys(resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name'))), '2022-10-01').primarySharedKey]"
          }
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.OperationalInsights/workspaces', format('{0}-logs', parameters('name')))]"
      ]
    },
    {
      "type": "Microsoft.App/managedEnvironments/storages",
      "apiVersion": "2024-03-01",
      "name": "[format('{0}/{1}', format('{0}-env', parameters('name')), 'psmcpkb-data')]",
      "properties": {
        "azureFile": {
          "accountName": "[variables('storageAccountName')]",
          "accountKey": "[listKeys(resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName')), '2023-01-01').keys[0].value]",
          "shareName": "[variables('shareName')]",
          "accessMode": "ReadWrite"
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "[resourceId('Microsoft.Storage/storageAccounts/fileServices/shares', variables('storageAccountName'), 'default', variables('shareName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', variables('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.App/containerApps",
      "apiVersion": "2024-03-01",
      "name": "[parameters('name')]",
      "location": "[parameters('location')]",
      "properties": {
        "managedEnvironmentId": "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "configuration": {
          "activeRevisionsMode": "Single",
          "ingress": {
            "external": true,
            "targetPort": 8080,
            "transport": "http",
            "allowInsecure": false
          },
          "secrets": "[concat(variables('apiKeySecrets'), variables('registrySecrets'))]",
          "registries": "[if(variables('useRegistry'), createArray(createObject('server', parameters('registryServer'), 'username', parameters('registryUsername'), 'passwordSecretRef', 'registry-password')), createArray())]"
        },
        "template": {
          "containers": [
            {
              "name": "psmcpkb",
              "image": "[parameters('image')]",
              "resources": {
                "cpu": "[json('0.5')]",
                "memory": "1Gi"
              },
              "env": "[concat(variables('apiKeyEnv'), createArray(createObject('name', 'PSMCPKB_KNOWLEDGEBASE', 'value', parameters('knowledgeBase')), createObject('name', 'PSMCPKB_DESCRIPTION', 'value', parameters('knowledgeBaseDescription')), createObject('name', 'PSMCPKB_ALLOW_WRITE', 'value', string(parameters('allowWrite'))), createObject('name', 'PSMCPKB_ALLOW_ANONYMOUS', 'value', string(parameters('allowAnonymous'))), createObject('name', 'PSMCPKB_ALLOWED_ORIGINS', 'value', parameters('allowedOrigins'))), if(empty(parameters('oauthClientId')), createArray(), createArray(createObject('name', 'PSMCPKB_OAUTH_ISSUER', 'value', format('{0}{1}/v2.0', environment().authentication.loginEndpoint, tenant().tenantId)), createObject('name', 'PSMCPKB_OAUTH_AUDIENCE', 'value', format('{0},{1}', parameters('oauthClientId'), if(empty(parameters('oauthResource')), format('https://{0}.{1}/mcp', parameters('name'), reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name'))), '2024-03-01').defaultDomain), parameters('oauthResource')))), createObject('name', 'PSMCPKB_OAUTH_SCOPE', 'value', format('{0}/{1}', if(empty(parameters('oauthResource')), format('https://{0}.{1}/mcp', parameters('name'), reference(resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name'))), '2024-03-01').defaultDomain), parameters('oauthResource')), parameters('oauthScope'))))))]",
              "volumeMounts": [
                {
                  "volumeName": "data",
                  "mountPath": "/data"
                }
              ],
              "probes": [
                {
                  "type": "Startup",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "initialDelaySeconds": 2,
                  "periodSeconds": 3,
                  "failureThreshold": 20
                },
                {
                  "type": "Liveness",
                  "httpGet": {
                    "path": "/health",
                    "port": 8080
                  },
                  "periodSeconds": 30
                }
              ]
            }
          ],
          "scale": {
            "minReplicas": "[parameters('minReplicas')]",
            "maxReplicas": "[parameters('maxReplicas')]"
          },
          "volumes": [
            {
              "name": "data",
              "storageType": "AzureFile",
              "storageName": "psmcpkb-data",
              "mountOptions": "uid=1654,gid=1654,dir_mode=0770,file_mode=0660"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.App/managedEnvironments', format('{0}-env', parameters('name')))]",
        "[resourceId('Microsoft.App/managedEnvironments/storages', format('{0}-env', parameters('name')), 'psmcpkb-data')]"
      ]
    }
